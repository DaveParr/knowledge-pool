-"""The Card node for an oracle id, created from the catalogue on first use. None if the id is unknown."""
+"""Run `f` with the guest as the acting identity, then put the caller back."""
+def as_guest(f: any) -> any {
+    ctx = Jac.get_context();
+    prev = ctx._user_root;
+    ctx._user_root = ctx._get_anchor(str(Jac.shared_root_id()));
+    try {
+        return f();
+    } finally {
+        ctx._user_root = prev;
+    }
+}
+
+"""Create the Card node under the catalogue as whoever is acting, open to every user at CONNECT."""
+def make_card(cat: Catalog, oid: str, c: dict[str, any]) -> Card {
+    card = Card(oracle_id=oid, name=c["name"] as str);
+    fill_card(card, c);
+    cat ++> card;
+    grant(card, level=AccessLevel.CONNECT);
+    return card;
+}
+
+"""The Card node for an oracle id, created from the catalogue on first use. None if the id is unknown.
+KP110_MODE=switch creates it as the guest whoever the caller is; otherwise as the caller."""
