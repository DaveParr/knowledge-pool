{
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills",
        "ref": "v1.3.2"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "mattpocock-skills@mattpocock": true
  },
  "permissions": {
    "allow": [
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment *)",
      "Bash(gh api repos/*/knowledge-pool/issues/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(scripts/board.sh *)",
      "Bash(jac guide *)",
      "Bash(uv run jac *)",
      "Bash(scripts/jac_test.sh *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(git push)",
      "Bash(scripts/start-ticket.sh *)",
      "Bash(scripts/check-ticket-link.sh *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin * main)",
      "Bash(gh api * --method DELETE*)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api --method DELETE *)",
      "Bash(gh api --method=DELETE *)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api -XDELETE *)",
      "Bash(gh pr merge * --delete-branch*)",
      "Bash(gh pr merge * -d*)",
      "Bash(gh pr merge --delete-branch*)",
      "Bash(gh repo delete*)",
      "Bash(git branch --delete *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git push * --delete *)",
      "Bash(git push * -d *)",
      "Bash(git push * :*)",
      "Bash(git push --delete *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-ticket-link-on-pr.sh"
          }
        ]
      }
    ]
  }
}
