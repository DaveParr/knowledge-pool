# Installed by `scripts/backup.sh install-timer`, which fills in the @...@ values.
[Unit]
Description=Knowledge Pool: dump the production database
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment="PATH=@PATH@"
Environment="KP_BACKUP_KEEP=@KEEP@"
Environment="KP_BACKUP_DIR=@BACKUP_DIR@"
ExecStart="@SCRIPT@" dump
