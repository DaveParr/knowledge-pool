# Installed by `scripts/backup.sh install-timer`. Persistent=true runs a missed
# dump at the next boot or login when the machine was off at the scheduled time.
[Unit]
Description=Knowledge Pool: dump the production database (@SCHEDULE@)

[Timer]
OnCalendar=@SCHEDULE@
Persistent=true
RandomizedDelaySec=15min

[Install]
WantedBy=timers.target
